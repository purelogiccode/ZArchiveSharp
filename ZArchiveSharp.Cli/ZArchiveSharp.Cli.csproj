<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>ZArchiveSharp.Cli</RootNamespace>
        <AssemblyName>ZArchiveSharp.Cli</AssemblyName>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>zar</ToolCommandName>
        <PackageId>ZArchiveSharp.Cli</PackageId>
        <Title>ZArchiveSharp CLI</Title>
        <Description>Command-line zar tool for creating and extracting ZArchive files using ZArchiveSharp (install with: dotnet tool install -g ZArchiveSharp.Cli)</Description>
        <PackageTags>zarchive;zar;zstd;compression;archive;cli</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>zar.png</PackageIcon>
        <IsPackable>true</IsPackable>
        <!-- Version is derived from git tags via MinVer (same as ZArchiveSharp library). -->
        <MinClientVersion>5.0</MinClientVersion>

        <!-- XML documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Trimming and AOT compatibility -->
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>

        <!-- Slim dotnet-tool payload: the tool ships no snupkg, so keep
             pdbs and XML docs out of tools/ (keeps the download small).
             Local bin/ output is unaffected. -->
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <CopyDocumentationFileToPublishDirectory>false</CopyDocumentationFileToPublishDirectory>

        <!-- Source Link + reproducible builds -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>portable</DebugType>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- API compatibility validation across target frameworks -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <EnableStrictModeForPackageValidation>true</EnableStrictModeForPackageValidation>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Cross-repo source dependency: path to the
             sibling XISOSharp checkout. Evaluated with Exists so a clean clone
             without the sibling still builds (CLI without iso support; the
             library, tests and benchmarks never need XISOSharp). Override with
             -p:XisoSharpAvailable=false to simulate that shape locally. -->
        <XisoSharpProject>..\..\CSharp_XISOSharp\XISOSharp\XISOSharp.csproj</XisoSharpProject>
        <XisoSharpAvailable Condition="'$(XisoSharpAvailable)' == '' and Exists('$(XisoSharpProject)')">true</XisoSharpAvailable>
        <XisoSharpAvailable Condition="'$(XisoSharpAvailable)' == ''">false</XisoSharpAvailable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(XisoSharpAvailable)' == 'true'">
        <DefineConstants>$(DefineConstants);HAS_XISO</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ZArchiveSharp\ZArchiveSharp.csproj" />
        <!-- When the sibling is absent the reference is skipped and Program.cs
              compiles its no-XISO shape (the iso flag fails at runtime with rebuild
              instructions; see HAS_XISO there). When present, one guard:
              MinVerSkip=true: MinVer 8 caches one version per MSBuild session
              keyed by options only (no repo path), so letting the sibling
              repo's MinVer run in our session nondeterministically stamps
              ZArchiveSharp.Cli.dll and the tool package with XISOSharp's version
              (observed: 1.0.1-alpha.0.99 instead of ours) and vice versa.
              Skipping it keeps our session's version hermetic; XISOSharp's own
              repo builds are unaffected. Mirror fix wanted on XISOSharp's
              reference back to ZArchiveSharp for the same reason.
              Known residual wart (pre-existing): under SOLUTION builds,
              out-of-solution references fall back to the default (Debug)
              configuration, so a solution-built Release tool links a
              Debug-built XISOSharp.dll (verified via DebuggableAttribute
              flags). Project builds and plain dotnet pack build it Release.
              Neither SetConfiguration metadata nor a Configuration pin in
              AdditionalProperties overrides the solution fallback (both
              verified ineffective); only replacing the source reference with
               a NuGet dependency fixes it. CI packs the library and the CLI
               tool per project (clean clone, no sibling present), so the
               shipped tool is Release-built and unaffected.
              Pack-shape rule: pack the CLI WITH its build (plain dotnet pack
              on the csproj); packing with the no-build flag after a solution
              build fails (MSB3030) because the Publish step resolves the
              Release-path dependency the solution build never produced. -->
        <ProjectReference Include="$(XisoSharpProject)" AdditionalProperties="MinVerSkip=true"
                          Condition="'$(XisoSharpAvailable)' == 'true'" />
    </ItemGroup>

    <Target Name="WarnMissingXisoSharp" BeforeTargets="BeforeBuild" Condition="'$(XisoSharpAvailable)' != 'true'">
        <Warning
            Text="XISOSharp sibling not found at '$(XisoSharpProject)': building zar WITHOUT --iso support. Clone https://github.com/purelogiccode/XISOSharp.git as a sibling 'CSharp_XISOSharp' directory and rebuild for XISO support." />
    </Target>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\ZArchiveSharp\icon\zar.png" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.235">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" Version="10.0.401" />
        <PackageReference Include="MinVer" PrivateAssets="all" Version="8.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>