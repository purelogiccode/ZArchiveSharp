<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>ZArchiveSharp.Cli</RootNamespace>
        <AssemblyName>ZArchiveSharp.Cli</AssemblyName>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>zar</ToolCommandName>
        <PackageId>ZArchiveSharp.Cli</PackageId>
        <Title>ZArchiveSharp CLI</Title>
        <Description>Command-line zar tool for creating and extracting ZArchive files using ZArchiveSharp (install with: dotnet tool install -g ZArchiveSharp.Cli)</Description>
        <PackageTags>zarchive;zar;zstd;compression;archive;cli</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>zar.png</PackageIcon>
        <IsPackable>true</IsPackable>
        <!-- Version is derived from git tags via MinVer (same as ZArchiveSharp library). -->
        <MinClientVersion>5.0</MinClientVersion>

        <!-- XML documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Trimming and AOT compatibility -->
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>

        <!-- Source Link + reproducible builds -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>portable</DebugType>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- API compatibility validation across target frameworks -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <EnableStrictModeForPackageValidation>true</EnableStrictModeForPackageValidation>
    </PropertyGroup>

    <!-- The apphost (native launcher) is renamed to ZArchiveSharp<ext> by
         RenameCliAppHost while the managed assembly keeps its
         ZArchiveSharp.Cli.dll name: this project references the ZArchiveSharp
         library below, which already owns ZArchiveSharp.dll in the output
         folder, so renaming the assembly to ZArchiveSharp would collide with
         the library (verified: MSB3243 conflict and the wrong assembly on
         disk). The apphost embeds the managed dll name, so only the launcher's
         file name changes. -->
    <PropertyGroup>
        <CliExecutableName>ZArchiveSharp</CliExecutableName>
    </PropertyGroup>

    <PropertyGroup>
        <!-- XISOSharp is consumed as a NuGet package
              (https://www.nuget.org/packages/XISOSharp), so no sibling checkout
              is required and Visual Studio solution restores always succeed.
              Override with -p:XisoSharpAvailable=false to build the no-XISO
              shape locally (CLI without iso support; the library, tests and
              benchmarks never need XISOSharp). -->
        <XisoSharpAvailable Condition="'$(XisoSharpAvailable)' == ''">true</XisoSharpAvailable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(XisoSharpAvailable)' == 'true'">
        <DefineConstants>$(DefineConstants);HAS_XISO</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\ZArchiveSharp\ZArchiveSharp.csproj" />
        <!-- The NuGet package is Release-built and does not run MinVer in this
              session, so both cross-repo reference warts are gone: no version
              stamping cross-contamination (no MinVerSkip guard needed) and
              solution builds no longer link a Debug-built XISOSharp.dll.
              Packing with the no-build flag after a solution build also works
              again: the dependency resolves from the NuGet cache, not a
              Release build output path. -->
        <PackageReference Include="XISOSharp" Version="1.0.2"
                          Condition="'$(XisoSharpAvailable)' == 'true'" />
    </ItemGroup>

    <Target Name="WarnXisoSharpDisabled" BeforeTargets="BeforeBuild" Condition="'$(XisoSharpAvailable)' != 'true'">
        <Warning
            Text="XISOSharp disabled (-p:XisoSharpAvailable=false): building zar WITHOUT --iso support." />
    </Target>

    <!-- _ComputeNETCoreBuildOutputFiles links the apphost into the output as
         $(AssemblyName)<ext>; re-link it under the CLI name so both build and
         publish output carry ZArchiveSharp<ext>. Skipped while packing so the
         platform-agnostic tool package keeps the SDK's standard shape (it
         filters the apphost by its canonical name; the tool entry point is the
         managed dll either way). -->
    <Target Name="RenameCliAppHost"
            AfterTargets="_ComputeNETCoreBuildOutputFiles"
            Condition="'$(_IsPacking)' != 'true' and '$(UseAppHost)' == 'true' and '$(AppHostIntermediatePath)' != ''">
        <ItemGroup>
            <None Remove="$(AppHostIntermediatePath)" />
            <None Include="$(AppHostIntermediatePath)">
                <Link>$(CliExecutableName)$(_NativeExecutableExtension)</Link>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
                <CopyToPublishDirectory>Always</CopyToPublishDirectory>
            </None>
        </ItemGroup>
    </Target>

    <!-- Single-file publish bundles the host itself, so the bundle IS the
          launcher and must carry the CLI name. The SDK looks the host up by
          file name (AppHostName = PublishedSingleFileName, hardcoded to
          $(AssemblyName)<ext> in _ComputeFilesToBundle) among the files to
          bundle; with the apphost relinked to ZArchiveSharp<ext> no item
          matches and GenerateBundle fails with "Must specify the host
          binary" (MSB4018). Rename the bundle to the CLI name and retarget
          any bundled item still named $(AssemblyName)<ext> (the self-contained
          single-file host) so the lookup succeeds and the bundle is emitted
          as ZArchiveSharp<ext> directly — no stale canonical exe to delete. -->
    <Target Name="RenameSingleFileBundleToCliName"
            AfterTargets="_ComputeFilesToBundle"
            Condition="'$(PublishSingleFile)' == 'true' and '$(_IsPacking)' != 'true'">
        <PropertyGroup>
            <PublishedSingleFileName>$(CliExecutableName)$(_NativeExecutableExtension)</PublishedSingleFileName>
            <PublishedSingleFilePath>$(PublishDir)$(PublishedSingleFileName)</PublishedSingleFilePath>
        </PropertyGroup>
        <ItemGroup>
            <_FilesToBundle
                Condition="'%(_FilesToBundle.RelativePath)' == '$(AssemblyName)$(_NativeExecutableExtension)'">
                <RelativePath>$(CliExecutableName)$(_NativeExecutableExtension)</RelativePath>
            </_FilesToBundle>
        </ItemGroup>
    </Target>

    <!-- dotnet run starts $(TargetDir)$(AssemblyName)<ext> unless RunCommand says
         otherwise; point it at the renamed apphost when it is present (a
         pack-only build still leaves the canonical apphost in place). Hooked to
         both Run (msbuild -t:Run) and ComputeRunArguments (dotnet run's
         RunCommand query). -->
    <Target Name="PointCliRunAtRenamedAppHost"
            BeforeTargets="Run;ComputeRunArguments"
            Condition="'$(_IsPacking)' != 'true' and '$(UseAppHost)' == 'true'">
        <PropertyGroup Condition="Exists('$(TargetDir)$(CliExecutableName)$(_NativeExecutableExtension)')">
            <RunCommand>$(TargetDir)$(CliExecutableName)$(_NativeExecutableExtension)</RunCommand>
        </PropertyGroup>
    </Target>

    <!-- The SDK's publish cleanup hardcodes $(AssemblyName)<ext> as a current
         publish output, so a ZArchiveSharp.Cli<ext> left in an existing publish
         directory survives the rename. Drop it once the renamed apphost is
         actually there. -->
    <Target Name="DeleteStaleCliAppHostFromPublishDir"
            AfterTargets="Publish"
            Condition="'$(_IsPacking)' != 'true' and '$(UseAppHost)' == 'true' and Exists('$(PublishDir)$(CliExecutableName)$(_NativeExecutableExtension)')">
        <Delete Files="$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)" TreatErrorsAsWarnings="true" />
    </Target>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="..\ZArchiveSharp\icon\zar.png" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.253">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" Version="10.0.401" />
        <PackageReference Include="MinVer" PrivateAssets="all" Version="8.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>